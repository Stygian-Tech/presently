FROM node:22-alpine AS web-build

WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./
ARG PUBLIC_SITE_URL=https://presently.photo
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL
RUN npm run check \
    && npm run build

FROM golang:1.26-alpine AS oauth-build

WORKDIR /src
COPY services/oauth-worker/go.mod ./
COPY services/oauth-worker/ ./

RUN CGO_ENABLED=0 GOOS=linux go test ./... \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /server .

FROM scratch

COPY --from=oauth-build /server /server
COPY --from=web-build /web/dist /site
USER 65532:65532
ENV PORT=8080
ENV PRESENTLY_SITE_DIR=/site
EXPOSE 8080

ENTRYPOINT ["/server"]
