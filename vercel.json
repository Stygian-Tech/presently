{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "oauth": {
      "root": "services/oauth-worker/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "oauth"
      }
    }
  ]
}
