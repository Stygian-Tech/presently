# This must be the stable, public URL that serves the metadata with no redirect.
PRESENTLY_CLIENT_ID=https://oauth.presently.photo/oauth/client-metadata.json

# The custom scheme must match the client_id hostname in reverse-domain order.
PRESENTLY_REDIRECT_URI=photo.presently.oauth:/oauth/callback

# Optional public links. Their host must match the client_id host.
PRESENTLY_CLIENT_URI=https://oauth.presently.photo
# PRESENTLY_POLICY_URI=https://oauth.presently.photo/privacy
# PRESENTLY_TOS_URI=https://oauth.presently.photo/terms
