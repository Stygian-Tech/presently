# This must be the stable, public URL that serves the metadata with no redirect.
PRESENTLY_CLIENT_ID=https://presently.stygian.tech/oauth/client-metadata.json

# The custom scheme must match the client_id hostname in reverse-domain order.
PRESENTLY_REDIRECT_URI=tech.stygian.presently:/oauth/callback

# Optional public links. Their host must match the client_id host.
PRESENTLY_CLIENT_URI=https://presently.stygian.tech
PRESENTLY_POLICY_URI=https://presently.stygian.tech/privacy
PRESENTLY_TOS_URI=https://presently.stygian.tech/terms
